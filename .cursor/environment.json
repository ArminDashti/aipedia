{
  "name": "AIPedia",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd aipedia-api && \"$HOME/go/bin/air\" -c .air.toml"
    },
    {
      "name": "webui",
      "command": "cd aipedia-webui && npm run dev -- --host 0.0.0.0 --port 5174"
    }
  ],
  "ports": [
    { "name": "api", "port": 8091 },
    { "name": "webui", "port": 5174 }
  ]
}
